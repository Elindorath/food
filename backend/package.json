{
  "name": "@food/backend",
  "version": "0.0.1",
  "description": "Backend API for food recipe application",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": "24.12.0"
  },
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "type-check": "tsc --pretty",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "11.1.10",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-fastify": "11.1.10",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/throttler": "6.5.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "drizzle-orm": "0.45.1",
    "fastify": "5.6.2",
    "helmet": "8.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "9.39.2",
    "@nestjs/cli": "11.0.14",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.10",
    "@swc/cli": "0.7.9",
    "@swc/core": "1.15.7",
    "@swc/jest": "0.2.39",
    "@swc/plugin-transform-imports": "^12.3.0",
    "@types/bcrypt": "6.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.4",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "^8.16.0",
    "@types/supertest": "6.0.3",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.31.8",
    "eslint": "9.39.2",
    "eslint-plugin-jest": "^29.11.1",
    "globals": "^16.5.0",
    "jest": "30.2.0",
    "jiti": "^2.6.1",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1"
  }
}
